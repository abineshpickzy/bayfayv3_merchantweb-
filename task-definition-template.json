{
  "family": "ProdDeployTaskDef",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::675034108238:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "node-app",
      "image": "675034108238.dkr.ecr.ap-south-1.amazonaws.com/prod",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}